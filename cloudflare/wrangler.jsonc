{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "namelessmc-cloudflare",
  "main": "./worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "NamelessContainer",
      "image": "../Dockerfile.cloudflare",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NAMELESS",
        "class_name": "NamelessContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NamelessContainer"]
    }
  ]
}
